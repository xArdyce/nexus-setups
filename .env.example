# Server-only PostgreSQL connection; use Neon's pooled runtime endpoint with TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Generate a unique random secret; NEXTAUTH_SECRET is a legacy alternative.
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Production canonical origin. Use the actual Preview origin in Preview,
# and http://localhost:3000 locally. NEXTAUTH_URL is a legacy fallback.
AUTH_URL=https://nexus-setups.vercel.app

# Private R2 bucket, with a bucket-scoped Object Read & Write credential.
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_BUCKET_NAME

# SMTP sender authorized by your provider. 587/false requires STARTTLS;
# 465/true uses TLS immediately. Certificate verification stays enabled.
# All six SMTP fields are required to send mail. For local debug-link-only
# testing, leave SMTP_HOST empty and do not copy real SMTP credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=Nexus Setups <no-reply@example.com>

# Operator-only, NOT a Vercel runtime requirement. Never commit a real password.
# ADMIN_INITIAL_PASSWORD=SET_ONLY_FOR_AN_INTENTIONAL_ADMIN_OPERATION
# NODE_ENV and VERCEL are framework/platform managed; do not override them.
